NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=merchant
DATABASE_PASSWORD=replace-with-local-database-password
DATABASE_NAME=merchant_onboarding
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_ORIGIN=http://localhost:3000
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_EMAIL=5
REFRESH_RATE_LIMIT_IP=60

# Part 2 seed command; use distinct local-only passwords.
SEED_ADMIN_PASSWORD=replace-with-admin-password
SEED_SALES_A_PASSWORD=replace-with-sales-a-password
SEED_SALES_B_PASSWORD=replace-with-sales-b-password
SEED_REVIEWER_A_PASSWORD=replace-with-reviewer-a-password
SEED_REVIEWER_B_PASSWORD=replace-with-reviewer-b-password
